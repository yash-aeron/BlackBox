# BlackBox configuration. Copy to `.env` and adjust; every value has a default,
# so an empty file is a valid configuration.

# --- persistence -------------------------------------------------------------
# SQLite is the zero-setup default. PostgreSQL is the deployment target:
#   BLACKBOX_DB=postgresql://blackbox:blackbox@127.0.0.1:5432/blackbox
BLACKBOX_DB=sqlite:///artifacts/blackbox.db

# Where screenshots, downloads, generated fixtures, exported models and
# benchmark reports are written.
BLACKBOX_ARTIFACTS=artifacts

# --- browser -----------------------------------------------------------------
BLACKBOX_HEADLESS=1
# Headed mode is for watching exploration; BLACKBOX_RECORDING also forces a
# visible window and stores screencast frames.
BLACKBOX_RECORDING=0
BLACKBOX_VIEWPORT_WIDTH=1440
BLACKBOX_VIEWPORT_HEIGHT=900
BLACKBOX_SCREENSHOTS=1
# Explicit Chromium/Chrome path. Empty means: probe the Playwright cache, then
# the usual system locations.
BLACKBOX_CHROMIUM=

# --- exploration -------------------------------------------------------------
BLACKBOX_SEED=7
# Unattended runs have no human to ask, so actions above the permitted risk are
# refused immediately and recorded instead of blocking the loop.
BLACKBOX_UNATTENDED=1
BLACKBOX_APPROVAL_TIMEOUT=120

# --- optional LLM provider ---------------------------------------------------
# none | openai-compatible. BlackBox never requires an LLM: everything the model
# claims is verified through browser observation.
BLACKBOX_LLM_PROVIDER=none
BLACKBOX_LLM_MODEL=gpt-4o-mini
BLACKBOX_LLM_BASE_URL=
BLACKBOX_LLM_API_KEY=
# How eagerly to consult the model: low | medium | high
BLACKBOX_LLM_FREQUENCY=low
BLACKBOX_LLM_CACHE=1
