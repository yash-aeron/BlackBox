{
  "name": "blackbox-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + TypeScript research dashboard for the BlackBox behavioural learner",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
